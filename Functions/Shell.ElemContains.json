  "formula": "=LAMBDA(point,nodes,[tol],LET(m,{ref}Shell.Rows3(nodes),p,{ref}Shell.Row3(point),count,ROWS(m),IF(AND(count<>3,count<>4),NA(),LET(box,{ref}Shell.ElemAABB(m),surfT,IF(ISOMITTED(tol),{ref}Shell.SurfTol(m),tol),inBox,{ref}Shell.PointInAABB(p,box,surfT),IF(inBox=FALSE,FALSE,IF(count=3,IF(ISOMITTED(tol),{ref}Shell.TriContains(p,m),{ref}Shell.TriContains(p,m,tol)),IF(ISOMITTED(tol),{ref}Shell.QuadContains(p,m),{ref}Shell.QuadContains(p,m,tol))))))))",
