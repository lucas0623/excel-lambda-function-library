  "formula": "=LAMBDA(nodes,IFERROR(LET(m,{ref}Shell.Rows3(nodes),tx,{ref}Shell.QuadTangent(m,{ref}Shell.QuadDNdXi(0,0)),te,{ref}Shell.QuadTangent(m,{ref}Shell.QuadDNdEta(0,0)),area,{ref}Shell.VecLen({ref}Shell.VecCross(tx,te)),L,{ref}Shell.CharLength(m),AND(ROWS(m)=4,COLUMNS(m)=3,ISNUMBER(area),ISNUMBER(L),L>0,area>0.000000000001*L*L)),FALSE))",
