{
  "name": "Strip.Stations",
  "formula": "=LAMBDA(point0,point1,nStat,LET(pta,{ref}Shell.Row3(point0),ptb,{ref}Shell.Row3(point1),delta,{ref}Shell.VecSub(ptb,pta),len,{ref}Shell.VecLen(delta),count,nStat,IF(OR(NOT(ISNUMBER(len)),len=0,NOT(ISNUMBER(count)),count<2),NA(),LET(frac,SEQUENCE(count,1,0,1)/(count-1),HSTACK(frac*len,INDEX(pta,1,1)+frac*INDEX(delta,1,1),INDEX(pta,1,2)+frac*INDEX(delta,1,2),INDEX(pta,1,3)+frac*INDEX(delta,1,3))))))",
  "comment": "Returns nStat rows of s, x, y, z along the centerline from point0 to point1. s is distance from point0. nStat must be at least 2. A zero-length strip returns #N/A. Last Update at 2026-11-04.",
  "children": [
    "Shell.Row3",
    "Shell.VecSub",
    "Shell.VecLen"
  ],
