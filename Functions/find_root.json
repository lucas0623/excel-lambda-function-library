{
  "name": "find_root",
  "formula": "=LAMBDA(target_y,x_vals,y_vals,LET(num_points,ROWS(x_vals),pt_indices,SEQUENCE(num_points),eval_segment,LAMBDA(idx,LET(x_start,INDEX(x_vals,idx),dy_start,INDEX(y_vals,idx)-target_y,IF(idx=num_points,IF(dy_start=0,x_start,NA()),LET(x_end,INDEX(x_vals,idx+1),dy_end,INDEX(y_vals,idx+1)-target_y,IF(dy_start=0,x_start,IF(dy_start*dy_end<0,x_start-dy_start*(x_end-x_start)/(dy_end-dy_start),NA())))))),all_intersections,MAP(pt_indices,eval_segment),FILTER(all_intersections,ISNUMBER(all_intersections),\"No roots found\")))",
